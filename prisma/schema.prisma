// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

model Import {
  id             String        @id @default(cuid())
  filename       String
  status         ImportStatus  @default(PROCESSING)
  totalRows      Int           @default(0)
  successfulRows Int           @default(0)
  failedRows     Int           @default(0)
  createdAt      DateTime      @default(now())

  transactions   Transaction[]
  importErrors   ImportError[]

  @@index([createdAt])
  @@index([status])
}

// Field is `message` (not `reason`) to match ImportValidationError in index.ts
model ImportError {
  id        String   @id @default(cuid())
  importId  String
  import    Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber Int
  message   String
  createdAt DateTime @default(now())

  @@index([importId])
}

// Matches TransactionInput in index.ts exactly: no transactionDate/description,
// createdAt is both the CSV column name AND the record's own timestamp.
model Transaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  amount        Float
  currency      String
  status        String
  failureReason String?
  createdAt     DateTime

  importId      String?
  import        Import?  @relation(fields: [importId], references: [id])

  @@index([importId])
  @@index([status])
  @@index([currency])
}
